.venv/
__pycache__/
*.pyc
.pytest_cache/
# app/data/*.json (projects.json, programs.json, system_config.json,
# plugins/core/*.json) used to be intentionally NOT ignored here (tracked in
# this repo so everyone got them via git pull / Update and Restart), but
# that meant any machine with an uncommitted local edit broke the
# self-update git pull outright. They moved to being synced via cloud
# storage instead (app/core/vcs/cloud_sync.py's R2JsonSync) - each a local
# cache of the shared bucket's blob, pulled on launch and pushed on every
# save - and then moved again to live outside app/ entirely (see
# UKOREHUB_DATA_DIR in app/launcher.py / developer/launcher/launcher_build/
# updater.py, same "survives every force-reset" reasoning as cache/storage
# below). Nothing under app/data/ is written by the running app anymore, but
# blanket-ignored (not itemized like the old per-file patterns used to be)
# so a leftover/orphaned file there - e.g. a per-project projects/<id>.json
# blob, which never had its own itemized pattern here and ended up
# accidentally git-tracked for a while - can never slip back into a commit.
/app/data/
# app/plugins/core is git-tracked and distributed like the old
# app/data/programs.json used to be - bundled with the app, no separate
# fetch. See app/core/extensibility/loader.py.
# Forced workspace_root (see app/launcher.py) - actual cloned target repos
# live here, per-machine and potentially huge; never tracked. Named
# storage/ (not projects/) specifically to avoid colliding with
# app/data/projects/ (the per-project metadata blobs - see
# developer/app/docs/data-layout.md).
/app/storage/
# Every per-machine, gitignored file UkoreHub itself owns lives under here -
# no README of its own (gitignored). Includes app/cache/plugins/, per-user
# clones of repo plugins (each its own git clone/remote/history,
# fetched/updated on demand for a repo that declares it as a requirement -
# see developer/app/docs/plugins-guide.md).
/app/cache/
# Per-machine workspace choice (see developer/launcher/launcher_build/
# updater.py's ensure_workspace_dir) - the folder itself usually lives on
# another drive entirely, but this covers the case where the picker was
# cancelled and it fell back to right here. Holds cache/ (login tokens),
# storage/ (cloned repos), and data/ (the R2 cloud-synced JSON registry),
# passed to app/launcher.py via UKOREHUB_CACHE_DIR/UKOREHUB_STORAGE_DIR/
# UKOREHUB_DATA_DIR so all three live outside app/ and survive its every
# force-reset update in a real (non-dev) install.
/workspace/
# Remembers the workspace_root chosen above - per-machine, a local
# filesystem path, never shared. Its presence has no effect on dev-mode
# detection (that's the developer/ folder itself - see
# developer/launcher/launcher_build/updater.py's _is_dev_checkout).
/launcher_config.json
# PyInstaller intermediates from developer/launcher/launcher_build/
# build_exe.py - regenerated every build, never committed. The resulting
# UkoreHubLauncher.exe at the repo root IS committed - a shared
# studio-wide binary artists' installs self-update from.
/developer/launcher/build/
*.spec
# The real shared Cloudflare R2 key, filled in locally from
# r2_credentials.example.py (tracked) before running build_exe.py - baked
# into UkoreHubLauncher.exe at build time, never committed here. See
# developer/launcher/launcher_build/r2_credentials.example.py and the
# ukorehub-cloud-sync skill.
/developer/launcher/launcher_build/r2_credentials.py
# Old UkoreHubLauncher.exe renamed aside by updater.py's
# _relocate_self_exe during a self-update (Windows won't let git overwrite
# the exe while it's running, but it will let it be renamed) - cleaned up
# automatically on the next launch, never committed.
/UkoreHubLauncher.exe.old-*
